# Local development env for `apps/web`.
# Copy to `.env.local` (gitignored). Wired in Cell 2.2.
#
# Get fresh values from: `supabase status`
#   - Project URL → NEXT_PUBLIC_SUPABASE_URL
#   - Publishable → NEXT_PUBLIC_SUPABASE_ANON_KEY
#   - Secret      → SUPABASE_SERVICE_ROLE_KEY (server-only, never ship to browser)

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Cell 3.3 + 3.4) — get test keys from
# https://dashboard.stripe.com/test/apikeys. The webhook secret is
# printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional: forces success/cancel URLs in the Checkout Session. Leave
# unset for localhost; set when running behind a tunnel (ngrok, etc.).
NEXT_PUBLIC_SITE_URL=

# Resend (Cell 4.1) — get an API key from https://resend.com/api-keys.
# When unset, the email client logs payloads to the server console
# instead of sending (handy for local dev). EMAIL_FROM defaults to
# Resend's sandbox sender; override with a verified domain in prod.
RESEND_API_KEY=
EMAIL_FROM=

# Shippo (Cell 6.1+) — get a test token from https://apps.goshippo.com/settings/api.
# When SHIPPO_API_KEY is unset, label/tracking calls log a warning and no-op
# instead of hitting the network (handy for local dev). The webhook secret is
# the value Shippo signs `track_updated` payloads with (Cell 6.3).
SHIPPO_API_KEY=
SHIPPO_WEBHOOK_SECRET=

# Warehouse "ship from" address (Cell 6.2). Required before any label can
# be generated from /console/orders/[id]. Leave WAREHOUSE_* vars unset in
# local dev — the dispatch action returns a clear error rather than mailing
# from a default address.
WAREHOUSE_NAME=
WAREHOUSE_STREET1=
WAREHOUSE_STREET2=
WAREHOUSE_CITY=
WAREHOUSE_STATE=
WAREHOUSE_ZIP=
WAREHOUSE_COUNTRY=
WAREHOUSE_PHONE=
WAREHOUSE_EMAIL=

# PostHog (Cell 7.1) — get a project key from https://app.posthog.com.
# Both browser + server SDKs read NEXT_PUBLIC_POSTHOG_KEY by default;
# set POSTHOG_KEY when you want to ship server-only events to a separate
# project. NEXT_PUBLIC_POSTHOG_HOST defaults to https://eu.i.posthog.com;
# override for the US region (https://us.i.posthog.com) or a reverse
# proxy. When unset, browser + server captures become console-logged
# no-ops so local dev works without a project.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
POSTHOG_KEY=

# Sentry (Cell 7.2) — error monitoring across browser, Node server, and
# Edge runtimes. NEXT_PUBLIC_SENTRY_DSN powers the browser SDK; SENTRY_DSN
# powers the server + edge SDKs (typically the same project DSN). When
# either is unset, the corresponding Sentry.init() call is skipped and
# the SDK becomes a no-op so local dev works without a project.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Upstash Redis (Cell 7.3) — backs the edge rate limiter on
# /api/webhooks/* and /api/invites/*. Free tier is plenty for our
# traffic. When unset the middleware falls back to an in-memory
# limiter that is per-instance (fine for `pnpm dev`, useless in
# production) and logs a warning at boot.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
