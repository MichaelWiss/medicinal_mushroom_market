# Local development env for `apps/web`.
# Copy to `.env.local` (gitignored). Wired in Cell 2.2.
#
# Get fresh values from: `supabase status`
#   - Project URL → NEXT_PUBLIC_SUPABASE_URL
#   - Publishable → NEXT_PUBLIC_SUPABASE_ANON_KEY
#   - Secret      → SUPABASE_SERVICE_ROLE_KEY (server-only, never ship to browser)

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Cell 3.3 + 3.4) — get test keys from
# https://dashboard.stripe.com/test/apikeys. The webhook secret is
# printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional: forces success/cancel URLs in the Checkout Session. Leave
# unset for localhost; set when running behind a tunnel (ngrok, etc.).
NEXT_PUBLIC_SITE_URL=
